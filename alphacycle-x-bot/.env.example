# Copy to .env and fill in. File must sit next to config.py.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER=
CLAUDE_API_KEY=
# Optional: model used only when daily primary (Sonnet) returns 529 overloaded; default Haiku. Use none to disable.
# CLAUDE_MODEL_DAILY_FALLBACK=claude-3-5-haiku-20241022
TELEGRAM_BOT_TOKEN=
# Optional: bot @username without @ (for group @-mentions if getMe is blocked).
# TELEGRAM_BOT_USERNAME=AlphaCycleXBot
# Chat id(s) for approvals + listener: comma or semicolon separated. Supergroups use -100...
# First id = default when code sends without explicit chat_id. Example: YOUR_DM_ID,-1001234567890
TELEGRAM_CHAT_ID=
# Optional: GNU screen session names for /logbot and /logtg (default xbot / tg).
# SCREEN_SESSION_BOT=xbot
# SCREEN_SESSION_TG=tg
# JSON API for bot (do not use alphacycle.app here if it returns HTML):
# ARC_API_URL=https://alphacycle-production.up.railway.app/api/arc-summary
# Optional: same host for cycle/btc etc. if ARC_API_URL host missing:
# ALPHACYCLE_PUBLIC_BASE=https://alphacycle-production.up.railway.app
# Optional overrides (save API credits: longer interval = fewer reads):
# SCAN_INTERVAL_SECONDS=1800
# Scanner / reply limits (defaults in config.py: 4h window, 5 likes, 3/hr, 15/day, 2 per @/day):
# MIN_TWEET_AGE_SECONDS=10
# SCAN_TWEET_MAX_AGE=14400
# MAX_TWEET_AGE_SECONDS=14400
# MIN_LIKES_TO_REPLY=5
# REPLY_LIMIT_HOURLY=3
# REPLY_LIMIT_DAILY=15
# MAX_REPLIES_PER_ACCOUNT_PER_DAY=2
