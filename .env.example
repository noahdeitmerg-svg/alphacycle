# Alpha Cycle Intelligence — Environment Variables
# Copy to .env and fill in your real values. NEVER put real keys in this file.

# FRED API Key (free at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# Cache refresh interval in seconds (default: 60)
CACHE_TTL_SECONDS=60

# Port (platform sets this automatically)
PORT=8000

# Claude API — set the REAL value ONLY in the Railway env, never here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Admin token for /api/subscribers — set a strong random value in Railway env
ADMIN_TOKEN=set_a_strong_random_value

# Checkout + webhooks + alerts — real values ONLY in platform env
LEMON_CHECKOUT_URL=
LEMONSQUEEZY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHANNEL_ID=
